<section class="py-16 px-4" style="background-color: #f9fafb;">
  <div class="max-w-screen-lg mx-auto text-center">
    <h2 class="mb-2 text-2xl font-bold text-gray-900">Try the Source Editor</h2>
    <p class="mb-8 text-gray-500">Pick a site and see how CloudCannon&rsquo;s Source Editable Regions work with real content.</p>
    <div class="flex flex-wrap justify-center gap-3">
      {% for site in demo_sites %}
      <a href="/demo/?site={{ site.slug }}" class="px-5 py-2.5 text-sm font-semibold rounded-lg bg-white border border-gray-200 hover:border-gray-300 hover:bg-gray-50 text-gray-700 shadow-sm transition-colors">
        {{ site.name }}
      </a>
      {% endfor %}
    </div>
  </div>
</section>