<section>
  <link rel="stylesheet" href="/demo-sites/jetstream/preview-styles.css" />
  <link rel="stylesheet" href="/demo-sites/sendit/preview-styles.css" />
  <div x-data="sourceEditorManager()" class="hidden max-w-screen-lg mx-auto md:block">

    <!-- Site Picker -->
    <div class="flex items-center gap-2 mb-3">
      <button
        class="px-3 py-1.5 text-xs font-semibold rounded-full transition-colors"
        :class="currentSite === 'jetstream' ? 'bg-gray-900 text-white' : 'bg-gray-100 text-gray-600 hover:bg-gray-200'"
        @click="switchSite('jetstream')">Jetstream</button>
      <button
        class="px-3 py-1.5 text-xs font-semibold rounded-full transition-colors"
        :class="currentSite === 'sendit' ? 'bg-gray-900 text-white' : 'bg-gray-100 text-gray-600 hover:bg-gray-200'"
        @click="switchSite('sendit')">Sendit</button>
    </div>

    <div
      id="source-demo-window"
      class="relative flex flex-row gap-3"
      style="height: 700px;">

      <!-- Left Panel: Code Editor -->
      <div class="relative flex flex-col w-1/2 overflow-hidden rounded-lg" style="border: 1px solid #313244;">
        {% bookshop "interactive-source-demo/bits/sidebar" %}
      </div>

      <!-- Right Panel: Visual Editor -->
      <div class="flex flex-col flex-1 overflow-hidden bg-white border-2 border-black rounded-lg shadow-lg">
        <div class="flex p-2 pl-4 space-x-2 border-b border-gray-200">
          <span class="w-2 h-2 bg-[#EA6053] rounded-full"></span>
          <span class="w-2 h-2 bg-[#F0B646] rounded-full"></span>
          <span class="w-2 h-2 bg-[#58BD4E] rounded-full"></span>
        </div>
        <div class="flex items-center justify-between px-3 py-1.5 border-b border-gray-200 bg-gray-50">
          <div class="flex items-center gap-2">
            <button class="p-1 rounded hover:bg-gray-200" aria-label="Back">
              <svg
                class="w-4 h-4 text-gray-400"
                xmlns="http://www.w3.org/2000/svg"
                fill="none"
                viewBox="0 0 24 24"
                stroke="currentColor"><path
                  stroke-linecap="round"
                  stroke-linejoin="round"
                  stroke-width="2"
                  d="M15 19l-7-7 7-7" /></svg>
            </button>
            <div class="flex items-center gap-2">
              <div class="flex items-center justify-center rounded w-7 h-7" style="background: #2b2b2b;">
                <svg
                  class="w-4 h-4 text-white"
                  xmlns="http://www.w3.org/2000/svg"
                  fill="none"
                  viewBox="0 0 24 24"
                  stroke="currentColor"><path
                    stroke-linecap="round"
                    stroke-linejoin="round"
                    stroke-width="2"
                    d="M9 12h6m-6 4h6m2 5H7a2 2 0 01-2-2V5a2 2 0 012-2h5.586a1 1 0 01.707.293l5.414 5.414a1 1 0 01.293.707V19a2 2 0 01-2 2z" /></svg>
              </div>
              <div class="leading-tight">
                <div class="text-sm font-semibold" x-text="showDataView ? 'Blog Post' : 'Home'"></div>
                <div class="text-xs text-gray-400" x-text="showDataView ? '/blog/' + site.blogSidebarBottomFilename.replace('.md', '') : '/'"></div>
              </div>
            </div>
          </div>
          <div class="flex items-center gap-3">
            <div class="flex items-center justify-center text-sm rounded-full w-7 h-7 bg-amber-100">🙂</div>
            <span
              class="text-xs"
              :class="hasChanges ? 'text-amber-600 font-semibold' : 'text-gray-400'"
              x-text="hasChanges ? 'Unsaved changes' : 'No pending changes'"></span>
            <div class="relative">
              <button
                class="save-btn text-xs font-semibold rounded-md transition-all"
                :class="hasChanges ? 'save-btn-active' : 'save-btn-inactive'"
                @click="showSaveModal = true">Save</button>
              <span
                x-show="hasChanges"
                x-transition:enter="transition ease-out duration-200"
                x-transition:enter-start="opacity-0 scale-0"
                x-transition:enter-end="opacity-100 scale-100"
                class="save-btn-badge">1</span>
            </div>
          </div>
        </div>
        {% bookshop "interactive-source-demo/bits/main" %}
      </div>

      <!-- Tutorial Tooltip -->
      <div
        x-show="activeTutorial !== null && tutorialStep <= 4"
        x-transition:enter="transition ease-out duration-200"
        x-transition:enter-start="opacity-0 scale-95"
        x-transition:enter-end="opacity-100 scale-100"
        x-transition:leave="transition ease-in duration-150"
        x-transition:leave-start="opacity-100 scale-100"
        x-transition:leave-end="opacity-0 scale-95"
        class="tutorial-tooltip"
        :style="'top: ' + tooltipTop() + 'px'">
        <div class="text-sm leading-snug text-gray-700" x-text="currentTooltipSteps[tutorialStep]?.text"></div>
        <div class="flex items-center justify-between mt-3">
          <span class="text-xs text-gray-400" x-text="(tutorialStep + 1) + ' / 5'"></span>
          <button
            class="px-3 py-1 text-xs font-semibold text-white rounded"
            style="background-color: #034AD8;"
            @click="nextStep()"
            x-text="currentTooltipSteps[tutorialStep]?.button"></button>
        </div>
      </div>

      <!-- Image Picker -->
      <div
        x-show="showImagePicker"
        x-transition:enter="transition ease-out duration-200"
        x-transition:enter-start="opacity-0 scale-95"
        x-transition:enter-end="opacity-100 scale-100"
        x-transition:leave="transition ease-in duration-150"
        x-transition:leave-start="opacity-100 scale-100"
        x-transition:leave-end="opacity-0 scale-95"
        class="image-picker"
        @click.outside="showImagePicker = false">
        <div class="flex items-center justify-between mb-3">
          <span class="text-sm font-semibold text-gray-800">Choose image</span>
          <button @click="showImagePicker = false" class="p-0.5 text-gray-400 rounded hover:text-gray-600 hover:bg-gray-100">
            <svg class="w-4 h-4" xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke="currentColor">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M6 18L18 6M6 6l12 12" />
            </svg>
          </button>
        </div>
        <div class="flex gap-1 p-0.5 mb-3 rounded-md" style="background: #f1f5f9;">
          <button
            class="flex-1 px-2 py-1 text-xs font-medium rounded transition-colors"
            :class="imagePickerMode === 'gallery' ? 'bg-white text-gray-800 shadow-sm' : 'text-gray-500 hover:text-gray-700'"
            @click="imagePickerMode = 'gallery'">Gallery</button>
          <button
            class="flex-1 px-2 py-1 text-xs font-medium rounded transition-colors"
            :class="imagePickerMode === 'url' ? 'bg-white text-gray-800 shadow-sm' : 'text-gray-500 hover:text-gray-700'"
            @click="imagePickerMode = 'url'">URL</button>
          <button
            class="flex-1 px-2 py-1 text-xs font-medium rounded transition-colors"
            :class="imagePickerMode === 'upload' ? 'bg-white text-gray-800 shadow-sm' : 'text-gray-500 hover:text-gray-700'"
            @click="imagePickerMode = 'upload'">Upload</button>
        </div>
        <template x-if="imagePickerMode === 'gallery'">
          <div class="image-picker-grid">
            <template x-for="preset in site.presetImages" :key="preset.previewSrc">
              <button
                class="image-picker-thumb"
                :class="heroImagePreviewSrc === preset.previewSrc && 'selected'"
                @click="applyPresetImage(preset)">
                <img :src="preset.previewSrc" alt="" />
              </button>
            </template>
          </div>
        </template>
        <template x-if="imagePickerMode === 'url'">
          <div>
            <input
              type="text"
              x-model="imagePickerUrl"
              placeholder="https://placebear.com/200/300"
              @keydown.enter="applyImageUrl()"
              class="w-full px-2.5 py-1.5 text-xs border border-gray-300 rounded-md focus:outline-none focus:ring-2 focus:ring-blue-500 focus:border-transparent" />
            <button
              @click="applyImageUrl()"
              :disabled="!imagePickerUrl.trim()"
              class="w-full px-3 py-1.5 mt-2 text-xs font-semibold text-white rounded-md transition-colors disabled:opacity-40"
              style="background-color: #034AD8;">Apply</button>
          </div>
        </template>
        <template x-if="imagePickerMode === 'upload'">
          <div>
            <label class="flex flex-col items-center justify-center gap-1.5 px-3 py-4 border-2 border-dashed border-gray-300 rounded-md cursor-pointer hover:border-gray-400 hover:bg-gray-50 transition-colors">
              <svg class="w-5 h-5 text-gray-400" xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 16v1a3 3 0 003 3h10a3 3 0 003-3v-1m-4-8l-4-4m0 0L8 8m4-4v12" />
              </svg>
              <span class="text-xs text-gray-500">Choose a file</span>
              <input type="file" accept="image/*" class="hidden" @change="handleImageUpload($event)" />
            </label>
          </div>
        </template>
      </div>

      <!-- Save Modal -->
      <div
        x-show="showSaveModal"
        x-transition:enter="transition ease-out duration-200"
        x-transition:enter-start="opacity-0"
        x-transition:enter-end="opacity-100"
        x-transition:leave="transition ease-in duration-150"
        x-transition:leave-start="opacity-100"
        x-transition:leave-end="opacity-0"
        class="fixed inset-0 z-50 flex items-center justify-center"
        style="background: rgba(0,0,0,0.4);"
        @click.self="showSaveModal = false">
        <div
          x-show="showSaveModal"
          x-transition:enter="transition ease-out duration-200"
          x-transition:enter-start="opacity-0 scale-95"
          x-transition:enter-end="opacity-100 scale-100"
          x-transition:leave="transition ease-in duration-150"
          x-transition:leave-start="opacity-100 scale-100"
          x-transition:leave-end="opacity-0 scale-95"
          class="save-modal-card">

          <div class="text-center">
            <div class="save-modal-checkmark">
              <svg class="w-6 h-6" xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2.5">
                <path stroke-linecap="round" stroke-linejoin="round" d="M5 13l4 4L19 7" />
              </svg>
            </div>
            <p class="mt-4 mb-1 text-gray-700">Together, we just added visual editing to a static site.</p>
            <p class="mb-6 font-semibold text-gray-900">Imagine what you could do with yours.</p>
            <a
              href="https://cloudcannon.com/free-trial/"
              target="_blank"
              rel="noopener"
              class="inline-block px-6 py-2.5 text-sm text-white font-semibold rounded-md transition-colors hover:opacity-90"
              style="background-color: #034AD8;">Sign up for a free trial</a>
            <a
              href="https://cloudcannon.com/documentation/"
              target="_blank"
              rel="noopener"
              class="block mt-3 text-sm font-medium text-gray-500 transition-colors hover:text-gray-700">Read the docs &rarr;</a>
          </div>

          <div x-show="!allTutorialsComplete" class="save-modal-divider"></div>
          <div x-show="!allTutorialsComplete" class="save-modal-tracks">
            <template x-for="track in tutorialTracks" :key="track.id">
              <button
                class="save-modal-track-row"
                :class="track.complete ? 'is-complete' : ''"
                :disabled="track.complete"
                @click="!track.complete && startTutorialFromModal(track)">
                <span class="save-modal-track-icon">
                  <template x-if="track.complete">
                    <svg class="w-3 h-3" xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="3">
                      <path stroke-linecap="round" stroke-linejoin="round" d="M5 13l4 4L19 7" />
                    </svg>
                  </template>
                </span>
                <span class="save-modal-track-label" x-text="track.label"></span>
                <span class="save-modal-track-count" x-text="track.stepsCompleted + '/' + track.totalSteps"></span>
                <svg x-show="!track.complete" class="w-3 h-3 ml-auto opacity-40" xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2.5" d="M9 5l7 7-7 7" />
                </svg>
              </button>
            </template>
          </div>
        </div>
      </div>
    </div>
  </div>

  <script>
    document.addEventListener('alpine:init', () => {
      Alpine.data('sourceEditorManager', () => ({
        hasChanges: false,
        showSaveModal: false,
        lastEditedProp: null,
        flashTimeout: null,
        currentSite: 'jetstream',

        activeTutorial: 'heading',
        tutorialStep: 0,
        lastAdvancedStep: null,
        advanceTimeout: null,
        headingTutorialComplete: false,
        imageTutorialComplete: false,
        dataTutorialComplete: false,
        highlightTarget: null,
        highlightTimeout: null,
        codeScrollTop: 0,

        blogTitle: 'Start building with Jetstream today',
        blogBody: 'Deploy your first project in <strong>under five minutes</strong>. Jetstream gives your team the infrastructure to ship faster, scale further, and sleep better at night. With edge-optimized delivery and <em>sub-50ms response times</em> worldwide, your users get the performance they deserve.',

        headingMain: 'Introducing',
        headingHighlight: 'Jetstream',
        description: 'A new Astro template by CloudCannon, built with our <a href="#">Astro Component Starter</a> for top performance, true visual editing, and an ideal developer experience.',

        heroImageSrc: '/dashboard.svg',
        heroImageAlt: 'Dashboard',
        heroImagePreviewSrc: '/demo-sites/jetstream/images/hero-1.svg',
        showImagePicker: false,
        imagePickerUrl: '',
        imagePickerMode: 'gallery',

        sites: {
          jetstream: {
            label: 'Jetstream',
            defaults: {
              headingMain: 'Introducing',
              headingHighlight: 'Jetstream',
              description: 'A new Astro template by CloudCannon, built with our <a href="#">Astro Component Starter</a> for top performance, true visual editing, and an ideal developer experience.',
            },
            regions: [
              { key: 'heading-main', prop: 'headingMain', tag: 'span' },
              { key: 'heading-highlight', prop: 'headingHighlight', tag: 'span', className: 'highlight' },
            ],
            sourcePath: '/index.astro',
            sidebarFilename: 'index.astro',
            imageDefaults: { src: '/dashboard.svg', alt: 'Dashboard', previewSrc: '/demo-sites/jetstream/images/hero-1.svg' },
            presetImages: [
              { src: '/dashboard.svg', previewSrc: '/demo-sites/jetstream/images/hero-1.svg' },
              { src: '/hero-2.svg', previewSrc: '/demo-sites/jetstream/images/hero-2.svg' },
              { src: '/hero-3.svg', previewSrc: '/demo-sites/jetstream/images/hero-3.svg' },
              { src: '/hero-4.svg', previewSrc: '/demo-sites/jetstream/images/hero-4.svg' },
              { src: '/hero-5.svg', previewSrc: '/demo-sites/jetstream/images/hero-5.svg' },
            ],
            imageKey: 'hero-image',
            blogDefaults: {
              blogTitle: 'Start building with Jetstream today',
              blogBody: 'Deploy your first project in <strong>under five minutes</strong>. Jetstream gives your team the infrastructure to ship faster, scale further, and sleep better at night. With edge-optimized delivery and <em>sub-50ms response times</em> worldwide, your users get the performance they deserve.',
            },
            blogSidebarTopFilename: 'pages/blog/[...slug].astro',
            blogSidebarBottomFilename: 'getting-started.md',
            blogDate: 'March 15, 2026',
            blogAuthor: 'Alex Chen',
          },
          sendit: {
            label: 'Sendit',
            defaults: {
              headingMain: 'Beautiful web campaigns',
              headingHighlight: '',
              description: 'With Sendit, you can quickly create beautiful rich emails that capture a reader\u2019s attention, engage them, and convert them into customers.',
            },
            regions: [
              { key: 'hero-title', prop: 'headingMain', tag: 'h1' },
            ],
            sourcePath: '/index.astro',
            sidebarFilename: 'index.astro',
            imageDefaults: { src: '/hero-image.avif', alt: 'Dashboard', previewSrc: '/demo-sites/sendit/images/hero-image.avif' },
            presetImages: [
              { src: '/hero-image.avif', previewSrc: '/demo-sites/sendit/images/hero-image.avif' },
              { src: '/hero-2.svg', previewSrc: '/demo-sites/sendit/images/hero-2.svg' },
              { src: '/hero-3.svg', previewSrc: '/demo-sites/sendit/images/hero-3.svg' },
              { src: '/hero-4.svg', previewSrc: '/demo-sites/sendit/images/hero-4.svg' },
              { src: '/hero-5.svg', previewSrc: '/demo-sites/sendit/images/hero-5.svg' },
            ],
            imageKey: 'hero-image',
            blogDefaults: {
              blogTitle: 'What are the best email clients?',
              blogBody: 'When you send an email campaign, you expect it to reach your readers, right? But what if the emails go straight to your subscribers\u2019 <strong>spam folders</strong> instead of their inboxes? To make sure your emails reach their recipients successfully, follow these <em>email delivery tips</em>.',
            },
            blogSidebarTopFilename: 'pages/blog/[...slug].astro',
            blogSidebarBottomFilename: 'best-email-clients.md',
            blogDate: 'March 7, 2022',
            blogAuthor: 'Wendy Parkes',
          },
        },

        get site() { return this.sites[this.currentSite]; },
        get regions() { return this.site.regions; },
        get sourcePath() { return this.site.sourcePath; },
        get sidebarFilename() { return this.site.sidebarFilename; },

        get headingSetupLevel() {
          if (this.headingTutorialComplete) return 4;
          if (this.activeTutorial === 'heading') return this.tutorialStep;
          return 0;
        },

        get imageSetupLevel() {
          if (this.imageTutorialComplete) return 4;
          if (this.activeTutorial === 'image') return this.tutorialStep;
          return 0;
        },

        get headingEditable() { return this.headingSetupLevel >= 3; },
        get imageEditable() { return this.imageSetupLevel >= 3; },

        get dataSetupLevel() {
          if (this.dataTutorialComplete) return 4;
          if (this.activeTutorial === 'data') return this.tutorialStep;
          return 0;
        },

        get titleEditable() { return this.dataSetupLevel >= 2; },
        get bodyEditable() { return this.dataSetupLevel >= 3; },

        get showDataView() {
          if (this.activeTutorial === 'data') return true;
          if (this.dataTutorialComplete && this.activeTutorial === null) return true;
          return false;
        },

        switchSite(name) {
          if (name === this.currentSite) return;
          this.currentSite = name;
          this.activeTutorial = 'heading';
          this.tutorialStep = 0;
          this.lastAdvancedStep = null;
          this.headingTutorialComplete = false;
          this.imageTutorialComplete = false;
          this.dataTutorialComplete = false;
          this.hasChanges = false;
          this.lastEditedProp = null;
          this.showImagePicker = false;
          this.imagePickerUrl = '';
          this.imagePickerMode = 'gallery';
          clearTimeout(this.flashTimeout);
          clearTimeout(this.advanceTimeout);
          const d = this.sites[name].defaults;
          this.headingMain = d.headingMain;
          this.headingHighlight = d.headingHighlight;
          this.description = d.description;
          const img = this.sites[name].imageDefaults;
          this.heroImageSrc = img.src;
          this.heroImageAlt = img.alt;
          this.heroImagePreviewSrc = img.previewSrc;
          const blog = this.sites[name].blogDefaults;
          this.blogTitle = blog.blogTitle;
          this.blogBody = blog.blogBody;
          this.codeScrollTop = 0;
          this.$nextTick(() => {
            const el = this.$refs.codeScroll;
            if (el) el.scrollTo({ top: 0 });
          });
        },

        headingTooltipSteps: [
          { text: 'This Astro page has hard-coded content. Let\u2019s make the heading editable with Source Editable Regions.', button: 'Start' },
          { text: 'This attribute tells CloudCannon that this element\u2019s content can be edited directly in the source.', button: 'Next' },
          { text: 'This tells CloudCannon which source file the content lives in.', button: 'Next' },
          { text: 'This unique key identifies the editable region. Each region in a file needs its own key.', button: 'Next' },
          { text: 'Your heading is set up! Try editing it on the right \u2014 the source updates in real time.', button: 'Try it' },
        ],

        imageTooltipSteps: [
          { text: 'This page also has a hero image. Let\u2019s make it editable too.', button: 'Start' },
          { text: 'This marks the image element as editable in the source.', button: 'Next' },
          { text: 'This tells CloudCannon which file the image belongs to.', button: 'Next' },
          { text: 'This key uniquely identifies the image region.', button: 'Next' },
          { text: 'Your image is set up! Click it on the right to pick a new one.', button: 'Try it' },
        ],

        dataTooltipSteps: [
          { text: 'This blog post renders structured data from markdown frontmatter. Let\u2019s make the title editable with Data Editables.', button: 'Start' },
          { text: 'This tells CloudCannon that this element shows editable text from structured data.', button: 'Next' },
          { text: 'This maps the element to the title field in the markdown frontmatter below.', button: 'Next' },
          { text: 'The @content prop makes the markdown body content editable in the visual editor.', button: 'Next' },
          { text: 'Your blog post is set up! Try editing the title and content on the right.', button: 'Try it' },
        ],

        get currentTooltipSteps() {
          if (this.activeTutorial === 'data') return this.dataTooltipSteps;
          if (this.activeTutorial === 'image') return this.imageTooltipSteps;
          return this.headingTooltipSteps;
        },

        regionLines(region, indent) {
          const s = this.headingSetupLevel;
          const adv = this.activeTutorial === 'heading' ? this.lastAdvancedStep : null;
          const val = this[region.prop];
          const pad = ' '.repeat(indent);
          const attrPad = ' '.repeat(indent + 2);
          const lines = [];

          if (s === 0) {
            const cls = region.className ? ` class="${region.className}"` : '';
            lines.push({ text: pad + '<' + region.tag + cls + '>' + val + '</' + region.tag + '>', isHeading: true });
            return lines;
          }

          lines.push({ text: pad + '<' + region.tag, isHeading: true });

          if (region.className) {
            lines.push({ text: attrPad + 'class="' + region.className + '"', isHeading: true });
          }

          if (s === 1) {
            lines.push({ text: attrPad + 'data-editable="source">', isNew: adv === 1, isHeading: true });
          } else {
            lines.push({ text: attrPad + 'data-editable="source"', isHeading: true });
          }

          if (s >= 2 && s === 2) {
            lines.push({ text: attrPad + 'data-path="' + this.sourcePath + '">', isNew: adv === 2, isHeading: true });
          } else if (s >= 2) {
            lines.push({ text: attrPad + 'data-path="' + this.sourcePath + '"', isHeading: true });
          }

          if (s >= 3) {
            lines.push({ text: attrPad + 'data-key="' + region.key + '">', isNew: adv === 3, isHeading: true });
          }

          lines.push(
            { text: attrPad + val, prop: region.prop, isHeading: true },
            { text: pad + '</' + region.tag + '>', isHeading: true },
          );

          return lines;
        },

        imageRegionLines(indent) {
          const s = this.imageSetupLevel;
          const adv = this.activeTutorial === 'image' ? this.lastAdvancedStep : null;
          const pad = ' '.repeat(indent);
          const attrPad = ' '.repeat(indent + 2);
          const lines = [];

          if (s === 0) {
            lines.push({ text: pad + '<img src="' + this.heroImageSrc + '" alt="' + this.heroImageAlt + '" />', isImage: true });
            return lines;
          }

          lines.push({ text: pad + '<img', isImage: true });
          lines.push({ text: attrPad + 'src="' + this.heroImageSrc + '"', prop: 'heroImageSrc', isImage: true });
          lines.push({ text: attrPad + 'alt="' + this.heroImageAlt + '"', isImage: true });

          if (s === 1) {
            lines.push({ text: attrPad + 'data-editable="source" />', isNew: adv === 1, isImage: true });
          } else {
            lines.push({ text: attrPad + 'data-editable="source"', isImage: true });
          }

          if (s >= 2 && s === 2) {
            lines.push({ text: attrPad + 'data-path="' + this.sourcePath + '" />', isNew: adv === 2, isImage: true });
          } else if (s >= 2) {
            lines.push({ text: attrPad + 'data-path="' + this.sourcePath + '"', isImage: true });
          }

          if (s >= 3) {
            lines.push({ text: attrPad + 'data-key="' + this.site.imageKey + '" />', isNew: adv === 3, isImage: true });
          }

          return lines;
        },

        get sourceLines() {
          return this.currentSite === 'sendit' ? this.senditSourceLines : this.jetstreamSourceLines;
        },

        get jetstreamSourceLines() {
          const lines = [];

          lines.push(
            { text: '---' },
            { text: 'import Layout from "../layouts/BaseLayout.astro"' },
            { text: '---' },
            { text: '' },
            { text: '<Layout title="home">' },
            { text: '  <section class="hero">' },
            { text: '    <h1>' },
          );

          for (const region of this.regions) {
            lines.push(...this.regionLines(region, 6));
          }

          lines.push(
            { text: '    </h1>' },
            { text: '    <p>A new Astro template by CloudCannon...</p>' },
            { text: '    <a href="/get-started" class="button">Deploy Jetstream</a>' },
          );

          lines.push(...this.imageRegionLines(4));

          lines.push(
            { text: '  </section>' },
            { text: '' },
            { text: '  <!-- ... Rest of page here -->' },
            { text: '' },
            { text: '</Layout>' },
          );

          return lines;
        },

        get senditSourceLines() {
          const lines = [];

          lines.push(
            { text: '---' },
            { text: 'import Layout from "../layouts/Layout.astro"' },
            { text: '---' },
            { text: '' },
            { text: '<Layout title="Home">' },
            { text: '  <section class="hero">' },
          );

          for (const region of this.regions) {
            lines.push(...this.regionLines(region, 4));
          }

          lines.push(
            { text: '    <p>With Sendit, you can quickly create...</p>' },
            { text: '    <a href="/signup" class="button">Try This Free</a>' },
          );

          lines.push(...this.imageRegionLines(4));

          lines.push(
            { text: '  </section>' },
            { text: '' },
            { text: '  <!-- ... Rest of page here -->' },
            { text: '' },
            { text: '</Layout>' },
          );

          return lines;
        },

        get dataPageSourceLines() {
          const s = this.dataSetupLevel;
          const adv = this.activeTutorial === 'data' ? this.lastAdvancedStep : null;
          const lines = [];

          lines.push(
            { text: '---' },
            { text: 'import Layout from "../layouts/Layout.astro"' },
            { text: 'import { getEntry } from "astro:content"' },
            { text: '' },
            { text: 'const post = await getEntry("blog", Astro.params.slug)' },
            { text: 'const { Content } = await post.render()' },
            { text: 'const { title, date, author } = post.data' },
            { text: '---' },
            { text: '' },
            { text: '<Layout>' },
            { text: '  <article>' },
          );

          if (s === 0) {
            lines.push({ text: '    <h1>{title}</h1>', isData: true });
          } else {
            lines.push({ text: '    <h1', isData: true });
            if (s === 1) {
              lines.push({ text: '      data-editable="text">', isNew: adv === 1, isData: true });
            } else {
              lines.push({ text: '      data-editable="text"', isData: true });
              lines.push({ text: '      data-prop="title">', isNew: adv === 2, isData: true, prop: 'blogTitle' });
            }
            lines.push(
              { text: '      {title}', isData: true },
              { text: '    </h1>', isData: true },
            );
          }

          lines.push(
            { text: '    <p class="meta">{date} · {author}</p>' },
            { text: '    <img src={featured_image} alt="..." />' },
            { text: '    <div class="max-w-4xl mx-auto prose lg:prose-xl">' },
          );

          if (s >= 3) {
            lines.push(
              { text: '      <editable-text data-prop="@content">', isNew: adv === 3, isBody: true },
              { text: '        <Content />', isBody: true },
              { text: '      </editable-text>', isNew: adv === 3, isBody: true },
            );
          } else {
            lines.push({ text: '      <Content />', isBody: true });
          }

          lines.push(
            { text: '    </div>' },
            { text: '  </article>' },
            { text: '</Layout>' },
          );

          return lines;
        },

        htmlToMarkdown(html) {
          return html
            .replace(/<\/?(strong|b)>/gi, '**')
            .replace(/<\/?(em|i)>/gi, '*')
            .replace(/<br\s*\/?>/gi, ' ')
            .replace(/<[^>]+>/g, '');
        },

        get dataMarkdownLines() {
          const site = this.site;
          const s = this.dataSetupLevel;
          const lines = [];

          lines.push(
            { text: '---', isFrontmatter: true },
            { text: 'title: ' + this.blogTitle, isFrontmatter: true, prop: 'blogTitle', highlightAt: s >= 2 },
            { text: 'date: ' + site.blogDate, isFrontmatter: true },
            { text: 'author: ' + site.blogAuthor, isFrontmatter: true },
            { text: 'featured_image:', isFrontmatter: true },
            { text: '  image: /images/blog/featured-image.jpg', isFrontmatter: true },
            { text: '  image_alt: Featured image', isFrontmatter: true },
            { text: 'draft: false', isFrontmatter: true },
            { text: '---', isFrontmatter: true },
            { text: '' },
          );

          const md = this.htmlToMarkdown(this.blogBody);
          const bodyLines = md.split(/(?<=\.)\s+/);
          for (const line of bodyLines) {
            lines.push({ text: line, isMarkdownBody: true });
          }

          return lines;
        },

        nextStep() {
          if (this.tutorialStep > 4) return;

          if (this.tutorialStep === 4) {
            if (this.activeTutorial === 'heading') {
              this.headingTutorialComplete = true;
              this.highlightTarget = 'heading';
            } else if (this.activeTutorial === 'image') {
              this.imageTutorialComplete = true;
              this.highlightTarget = 'image';
            } else if (this.activeTutorial === 'data') {
              this.dataTutorialComplete = true;
              this.highlightTarget = 'data';
            }
            this.activeTutorial = null;
            clearTimeout(this.highlightTimeout);
            this.highlightTimeout = setTimeout(() => { this.highlightTarget = null; }, 2000);
            return;
          }

          this.tutorialStep++;

          if (this.tutorialStep >= 1 && this.tutorialStep <= 3) {
            this.lastAdvancedStep = this.tutorialStep;
            clearTimeout(this.advanceTimeout);
            this.advanceTimeout = setTimeout(() => {
              this.lastAdvancedStep = null;
            }, 1500);
          }

          this.$nextTick(() => this.scrollToActiveLine());
        },

        startImageTutorial() {
          this.activeTutorial = 'image';
          this.tutorialStep = 0;
          this.lastAdvancedStep = null;
          this.$nextTick(() => this.scrollToActiveLine());
        },

        startDataTutorial() {
          this.activeTutorial = 'data';
          this.tutorialStep = 0;
          this.lastAdvancedStep = null;
          this.codeScrollTop = 0;
          this.$nextTick(() => {
            const el = this.$refs.dataCodeScrollTop;
            if (el) el.scrollTo({ top: 0 });
            this.scrollToActiveLine();
          });
        },

        rawTooltipTop() {
          const lineH = 24;
          const tabH = 32;

          if (this.activeTutorial === 'data') {
            const dataTabH = 36;
            switch (this.tutorialStep) {
              case 0: return dataTabH + 11 * lineH;
              case 1: return dataTabH + 12 * lineH;
              case 2: return dataTabH + 13 * lineH;
              case 3: return dataTabH + 19 * lineH;
              case 4: return dataTabH + 11 * lineH;
              default: return 0;
            }
          }

          if (this.activeTutorial === 'image') {
            if (this.currentSite === 'sendit') {
              switch (this.tutorialStep) {
                case 0: return tabH + 14 * lineH;
                case 1: return tabH + 17 * lineH;
                case 2: return tabH + 18 * lineH;
                case 3: return tabH + 19 * lineH;
                case 4: return tabH + 14 * lineH;
                default: return 0;
              }
            }
            switch (this.tutorialStep) {
              case 0: return tabH + 23 * lineH;
              case 1: return tabH + 26 * lineH;
              case 2: return tabH + 27 * lineH;
              case 3: return tabH + 28 * lineH;
              case 4: return tabH + 23 * lineH;
              default: return 0;
            }
          }

          if (this.currentSite === 'sendit') {
            switch (this.tutorialStep) {
              case 0: return tabH + 5 * lineH;
              case 1: return tabH + 6 * lineH;
              case 2: return tabH + 7 * lineH;
              case 3: return tabH + 8 * lineH;
              case 4: return tabH + 5 * lineH;
              default: return 0;
            }
          }
          switch (this.tutorialStep) {
            case 0: return tabH + 6 * lineH;
            case 1: return tabH + 8 * lineH;
            case 2: return tabH + 9 * lineH;
            case 3: return tabH + 10 * lineH;
            case 4: return tabH + 6 * lineH;
            default: return 0;
          }
        },

        tooltipTop() {
          const raw = this.rawTooltipTop();
          const visual = raw - this.codeScrollTop;
          return Math.max(60, Math.min(visual, 540));
        },

        scrollToActiveLine() {
          const el = this.activeTutorial === 'data'
            ? this.$refs.dataCodeScrollTop
            : this.$refs.codeScroll;
          if (!el) return;
          const rawTop = this.rawTooltipTop();
          const offsetH = this.activeTutorial === 'data' ? 36 : 32;
          const lineY = rawTop - offsetH;
          const viewH = el.clientHeight;
          const targetScroll = Math.max(0, lineY - viewH * 0.4);
          el.scrollTo({ top: targetScroll, behavior: 'smooth' });
          this.codeScrollTop = targetScroll;
        },

        applyPresetImage(preset) {
          this.heroImageSrc = preset.src;
          this.heroImagePreviewSrc = preset.previewSrc;
          this.showImagePicker = false;
          this.onEdit('heroImageSrc');
        },

        applyImageUrl() {
          if (!this.imagePickerUrl.trim()) return;
          this.heroImageSrc = this.imagePickerUrl.trim();
          this.heroImagePreviewSrc = this.imagePickerUrl.trim();
          this.showImagePicker = false;
          this.imagePickerUrl = '';
          this.onEdit('heroImageSrc');
        },

        handleImageUpload(event) {
          const file = event.target.files?.[0];
          if (!file) return;
          this.heroImagePreviewSrc = URL.createObjectURL(file);
          this.heroImageSrc = '/uploads/' + file.name;
          this.showImagePicker = false;
          this.imagePickerUrl = '';
          this.onEdit('heroImageSrc');
        },

        onEdit(prop) {
          this.hasChanges = true;
          this.lastEditedProp = prop;
          this.highlightTarget = null;
          clearTimeout(this.highlightTimeout);
          clearTimeout(this.flashTimeout);
          this.flashTimeout = setTimeout(() => {
            this.lastEditedProp = null;
          }, 1500);
        },

        get allTutorialsComplete() {
          return this.headingTutorialComplete && this.imageTutorialComplete && this.dataTutorialComplete;
        },

        get tutorialTracks() {
          return [
            {
              id: 'heading',
              label: 'Configure text editing',
              complete: this.headingTutorialComplete,
              stepsCompleted: this.headingTutorialComplete ? 5 : (this.activeTutorial === 'heading' ? this.tutorialStep : 0),
              totalSteps: 5,
            },
            {
              id: 'image',
              label: 'Configure image editing',
              complete: this.imageTutorialComplete,
              stepsCompleted: this.imageTutorialComplete ? 5 : (this.activeTutorial === 'image' ? this.tutorialStep : 0),
              totalSteps: 5,
            },
            {
              id: 'data',
              label: 'Configure structured data',
              complete: this.dataTutorialComplete,
              stepsCompleted: this.dataTutorialComplete ? 5 : (this.activeTutorial === 'data' ? this.tutorialStep : 0),
              totalSteps: 5,
            },
          ];
        },

        startTutorialFromModal(track) {
          this.showSaveModal = false;
          if (track.id === this.activeTutorial) return;
          if (track.id === 'heading') {
            this.activeTutorial = 'heading';
            this.tutorialStep = 0;
          } else if (track.id === 'image') {
            this.startImageTutorial();
          } else if (track.id === 'data') {
            this.startDataTutorial();
          }
        },
      }));
    });
  </script>

