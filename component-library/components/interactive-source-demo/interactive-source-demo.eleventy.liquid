<section>
  <div
    id="source-demo-window"
    x-data="sourceEditorManager()"
    class="relative hidden max-w-screen-lg mx-auto md:flex md:flex-row gap-3"
    style="height: 700px;">
    <div
      x-show="processedHtml && sourceOpen"
      x-cloak
      class="w-[48%] shrink-0 overflow-hidden flex flex-col rounded-lg border-2 border-black shadow-lg"
      style="background: #1e1e2e;">
      <div class="flex p-2 pl-4 space-x-2 border-b" style="border-color: #313244;">
        <span class="w-2 h-2 bg-[#EA6053] rounded-full"></span>
        <span class="w-2 h-2 bg-[#F0B646] rounded-full"></span>
        <span class="w-2 h-2 bg-[#58BD4E] rounded-full"></span>
      </div>
      {% bookshop "interactive-source-demo/bits/sidebar" %}
    </div>
    <div class="flex-1 min-w-0 overflow-hidden flex flex-col text-black bg-white rounded-lg border-2 border-black shadow-lg">
      <div class="flex p-2 pl-4 space-x-2 border-b-2 border-black">
        <span class="w-2 h-2 bg-[#EA6053] rounded-full"></span>
        <span class="w-2 h-2 bg-[#F0B646] rounded-full"></span>
        <span class="w-2 h-2 bg-[#58BD4E] rounded-full"></span>
      </div>
      <div class="flex items-center justify-between px-3 py-1.5 border-b border-gray-200">
        <div class="flex items-center gap-3">
          <svg class="w-6 h-6" viewBox="0 0 36 36" fill="none" xmlns="http://www.w3.org/2000/svg">
            <path d="M18 3L3 10.5V25.5L18 33L33 25.5V10.5L18 3Z" fill="#F56B2A"/>
            <path d="M18 10C14.134 10 11 13.134 11 17C11 19.388 12.18 21.498 14 22.748V26H16V23.93C16.634 24.14 17.304 24.26 18 24.26C18.696 24.26 19.366 24.14 20 23.93V26H22V22.748C23.82 21.498 25 19.388 25 17C25 13.134 21.866 10 18 10ZM15.5 17C15.5 16.172 16.172 15.5 17 15.5C17.828 15.5 18.5 16.172 18.5 17C18.5 17.828 17.828 18.5 17 18.5C16.172 18.5 15.5 17.828 15.5 17ZM20.5 17C20.5 16.172 19.828 15.5 19 15.5C19.828 15.5 20.5 16.172 20.5 17C20.5 17.828 19.828 18.5 19 18.5C19.828 18.5 20.5 17.828 20.5 17Z" fill="white" fill-opacity="0.9"/>
