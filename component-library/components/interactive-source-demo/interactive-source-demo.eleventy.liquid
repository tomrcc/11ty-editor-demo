            <circle cx="14" cy="14" r="14" fill="#E5E7EB"/>
            <circle cx="10" cy="12" r="1.5" fill="#374151"/>
            <circle cx="18" cy="12" r="1.5" fill="#374151"/>
            <path d="M9.5 17.5C10.5 19.5 12 20.5 14 20.5C16 20.5 17.5 19.5 18.5 17.5" stroke="#374151" stroke-width="1.5" stroke-linecap="round" fill="none"/>
