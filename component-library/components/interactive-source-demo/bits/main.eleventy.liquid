<!-- Jetstream homepage preview -->
<template x-if="!showDataView">
<div class="relative z-10 h-full flex-1 min-w-0 overflow-y-auto bg-white jt-preview">
  <!-- Nav -->
  <nav class="jt-nav">
    <div class="jt-nav-inner">
      <a href="/" class="jt-nav-logo">
        <img src="/demo-sites/jetstream/images/jetstream-logo.svg" alt="Jetstream" />
      </a>
      <ul class="jt-nav-links">
        <li><a href="#">Features</a></li>
        <li><a href="#">Blog</a></li>
        <li><a href="#">Pricing</a></li>
        <li><a href="#">About</a></li>
        <li><a href="#">Contact</a></li>
      </ul>
      <div class="jt-nav-end">
        <a href="#" class="jt-btn jt-btn-primary">Get started →</a>
      </div>
    </div>
  </nav>

  <!-- Hero -->
  <section class="jt-hero">
    <div class="jt-hero-bg"></div>
    <div class="jt-hero-content">
      <h1>
        <span
          :class="[headingEditable && 'editable-region', highlightTarget === 'heading' && 'editable-region-highlight']"
          :contenteditable="headingEditable"
          x-effect="let t = headingMain; if (document.activeElement !== $el) $el.textContent = t"
          @input="headingMain = $el.textContent; onEdit('headingMain')"></span><br />
        <span class="jt-highlight"
          :class="[headingEditable && 'editable-region', highlightTarget === 'heading' && 'editable-region-highlight']"
          :contenteditable="headingEditable"
          x-effect="let t = headingHighlight; if (document.activeElement !== $el) $el.textContent = t"
          @input="headingHighlight = $el.textContent; onEdit('headingHighlight')"></span>
      </h1>
      <p class="jt-hero-subtext"
        x-effect="let d = description; if (document.activeElement !== $el) $el.innerHTML = d"></p>
      <div class="jt-hero-buttons">
        <a href="#" class="jt-btn jt-btn-primary">Deploy Jetstream on CloudCannon →</a>
        <a href="#" class="jt-btn jt-btn-tertiary">Check out the Component Starter →</a>
      </div>
    </div>
    <div class="jt-hero-image">
      <img src="/demo-sites/jetstream/images/hero-1.svg" alt="Dashboard overview" />
    </div>
  </section>

  <!-- Logo strip -->
  <section class="jt-logo-strip">
    <p class="jt-logo-strip-heading">Trusted by industry leaders</p>
    <div class="jt-logo-strip-track">
      <img src="/demo-sites/jetstream/images/apex.svg" alt="Apex" />
      <img src="/demo-sites/jetstream/images/aura.svg" alt="Aura" />
      <img src="/demo-sites/jetstream/images/fintech.svg" alt="FinTech" />
      <img src="/demo-sites/jetstream/images/medical.svg" alt="Medical" />
      <img src="/demo-sites/jetstream/images/dental.svg" alt="Dental" />
      <img src="/demo-sites/jetstream/images/fake-uni.svg" alt="University" />
    </div>
  </section>

  <!-- Features -->
  <section class="jt-features">
    <div class="jt-features-header">
      <h2 class="jt-section-heading">What we do best</h2>
      <p class="jt-section-subtext">Jetstream gives your team the infrastructure to ship faster, scale further, and sleep better at night.</p>
    </div>
    <div class="jt-features-grid">
      <div class="jt-feature-card">
        <div class="jt-feature-icon">⚡</div>
        <h3 class="jt-feature-title">Lightning Fast</h3>
        <p class="jt-feature-desc">Edge-optimized delivery with sub-50ms response times worldwide.</p>
      </div>
      <div class="jt-feature-card">
        <div class="jt-feature-icon">🔒</div>
        <h3 class="jt-feature-title">Secure by Default</h3>
        <p class="jt-feature-desc">Enterprise-grade security with automatic SSL and DDoS protection.</p>
      </div>
      <div class="jt-feature-card">
        <div class="jt-feature-icon">📊</div>
        <h3 class="jt-feature-title">Real-time Analytics</h3>
        <p class="jt-feature-desc">Monitor performance and usage with built-in dashboards.</p>
      </div>
      <div class="jt-feature-card">
        <div class="jt-feature-icon">🔄</div>
        <h3 class="jt-feature-title">Auto Scaling</h3>
        <p class="jt-feature-desc">Seamlessly handle traffic spikes without manual intervention.</p>
      </div>
      <div class="jt-feature-card">
        <div class="jt-feature-icon">🛠️</div>
        <h3 class="jt-feature-title">Developer First</h3>
        <p class="jt-feature-desc">Powerful APIs, CLI tools, and integrations your team already loves.</p>
      </div>
    </div>
  </section>

  <!-- CTA -->
  <section class="jt-cta">
    <div class="jt-cta-inner">
      <div class="jt-cta-bg-lines"></div>
      <div class="jt-cta-content">
        <h2 class="jt-cta-heading">Start building with Jetstream today</h2>
        <p class="jt-cta-subtext">Deploy your first project in under five minutes.</p>
        <a href="#" class="jt-btn jt-btn-primary">Get started for free →</a>
      </div>
    </div>
  </section>

  <!-- Footer -->
  <footer class="jt-footer">
    <div class="jt-footer-top">
      <div class="jt-footer-logo">
        <img src="/demo-sites/jetstream/images/jetstream-logo.svg" alt="Jetstream" />
      </div>
      <ul class="jt-footer-links">
        <li><a href="#">Home</a></li>
        <li><a href="#">Pricing</a></li>
        <li><a href="#">Blog</a></li>
        <li><a href="#">About</a></li>
        <li><a href="#">Contact</a></li>
      </ul>
    </div>
    <hr class="jt-footer-divider" />
    <div class="jt-footer-bottom">
      <span class="jt-footer-legal">© 2026 All rights reserved.</span>
      <div class="jt-footer-socials">
        <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M16 8a6 6 0 0 1 6 6v7h-4v-7a2 2 0 0 0-4 0v7h-4v-7a6 6 0 0 1 6-6z"/><rect x="2" y="9" width="4" height="12"/><circle cx="4" cy="4" r="2"/></svg>
        <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M9 19c-5 1.5-5-2.5-7-3m14 6v-3.87a3.37 3.37 0 0 0-.94-2.61c3.14-.35 6.44-1.54 6.44-7A5.44 5.44 0 0 0 20 4.77 5.07 5.07 0 0 0 19.91 1S18.73.65 16 2.48a13.38 13.38 0 0 0-7 0C6.27.65 5.09 1 5.09 1A5.07 5.07 0 0 0 5 4.77a5.44 5.44 0 0 0-1.5 3.78c0 5.42 3.3 6.61 6.44 7A3.37 3.37 0 0 0 9 18.13V22"/></svg>
      </div>
    </div>
  </footer>

  <!-- Tutorial overlay -->
  <div
    x-show="activeTutorial !== null && tutorialStep <= maxTutorialStep"
    x-transition:leave="transition ease-out duration-300"
    x-transition:leave-start="opacity-100"
    x-transition:leave-end="opacity-0"
    class="absolute inset-0 z-10 pointer-events-none"
    style="background: rgba(255, 255, 255, 0.6);"></div>
</div>
</template>

<!-- Jetstream blog post preview -->
<template x-if="showDataView">
<div class="relative z-10 h-full flex-1 min-w-0 overflow-y-auto bg-white jt-preview">
  <nav class="jt-nav">
    <div class="jt-nav-inner">
      <a href="/" class="jt-nav-logo">
        <img src="/demo-sites/jetstream/images/jetstream-logo.svg" alt="Jetstream" />
      </a>
      <ul class="jt-nav-links">
        <li><a href="#">Features</a></li>
        <li><a href="#">Blog</a></li>
        <li><a href="#">Pricing</a></li>
        <li><a href="#">About</a></li>
        <li><a href="#">Contact</a></li>
      </ul>
      <div class="jt-nav-end">
        <a href="#" class="jt-btn jt-btn-primary">Get started &rarr;</a>
      </div>
    </div>
  </nav>

  <section class="jt-blog-hero">
    <h1 class="jt-blog-title"
      :class="[titleEditable && 'editable-region', highlightTarget === 'data' && 'editable-region-highlight']"
      :contenteditable="titleEditable"
      x-effect="let t = blogTitle; if (document.activeElement !== $el) $el.textContent = t"
      @input="blogTitle = $el.textContent; onEdit('blogTitle')"></h1>
    <div class="jt-blog-meta">
      <span x-text="site.blogDate"></span>
      <span class="jt-blog-meta-divider"></span>
      <span x-text="site.blogAuthor"></span>
      <span class="jt-blog-meta-divider"></span>
      <span>3 min read</span>
    </div>
    <div class="jt-blog-image" :style="imageEditable && 'overflow: visible'">
      <img
        :src="imageEditable ? heroImagePreviewSrc : '/demo-sites/jetstream/images/hero-1.svg'"
        :class="[imageEditable && 'editable-region-image', highlightTarget === 'image' && 'editable-region-highlight']"
        @click="imageEditable && (showImagePicker = !showImagePicker)"
        :alt="imageEditable ? heroImageAlt : 'Featured image'" />
    </div>
  </section>

  <div class="blog-body-toolbar" x-show="bodyEditable" x-cloak>
    <button @mousedown.prevent="document.execCommand('bold')"><strong>B</strong></button>
    <button @mousedown.prevent="document.execCommand('italic')"><em>I</em></button>
  </div>
  <div class="jt-blog-body"
    :class="[bodyEditable && 'editable-region', highlightTarget === 'data' && 'editable-region-highlight']"
    :contenteditable="bodyEditable"
    x-effect="let b = blogBody; if (document.activeElement !== $el) $el.innerHTML = b"
    @input="blogBody = $el.innerHTML; onEdit('blogBody')"></div>

  <footer class="jt-footer">
    <div class="jt-footer-top">
      <div class="jt-footer-logo">
        <img src="/demo-sites/jetstream/images/jetstream-logo.svg" alt="Jetstream" />
      </div>
      <ul class="jt-footer-links">
        <li><a href="#">Home</a></li>
        <li><a href="#">Pricing</a></li>
        <li><a href="#">Blog</a></li>
        <li><a href="#">About</a></li>
        <li><a href="#">Contact</a></li>
      </ul>
    </div>
    <hr class="jt-footer-divider" />
    <div class="jt-footer-bottom">
      <span class="jt-footer-legal">&copy; 2026 All rights reserved.</span>
      <div class="jt-footer-socials">
        <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M16 8a6 6 0 0 1 6 6v7h-4v-7a2 2 0 0 0-4 0v7h-4v-7a6 6 0 0 1 6-6z"/><rect x="2" y="9" width="4" height="12"/><circle cx="4" cy="4" r="2"/></svg>
        <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M9 19c-5 1.5-5-2.5-7-3m14 6v-3.87a3.37 3.37 0 0 0-.94-2.61c3.14-.35 6.44-1.54 6.44-7A5.44 5.44 0 0 0 20 4.77 5.07 5.07 0 0 0 19.91 1S18.73.65 16 2.48a13.38 13.38 0 0 0-7 0C6.27.65 5.09 1 5.09 1A5.07 5.07 0 0 0 5 4.77a5.44 5.44 0 0 0-1.5 3.78c0 5.42 3.3 6.61 6.44 7A3.37 3.37 0 0 0 9 18.13V22"/></svg>
      </div>
    </div>
  </footer>

  <div
    x-show="(activeTutorial === 'data' || activeTutorial === 'image') && tutorialStep <= maxTutorialStep"
    x-transition:leave="transition ease-out duration-300"
    x-transition:leave-start="opacity-100"
    x-transition:leave-end="opacity-0"
    class="absolute inset-0 z-10 pointer-events-none"
    style="background: rgba(255, 255, 255, 0.6);"></div>
</div>
</template>
